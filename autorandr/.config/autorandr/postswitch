#!/bin/sh

LAPTOP="eDP"
LEFT_PRIMARY="DisplayPort-2"
RIGHT_PRIMARY="DisplayPort-1"
LEFT_ALT="DisplayPort-4"
RIGHT_ALT="DisplayPort-3"
DOCKED_DPI="100"
LAPTOP_DPI="100"

is_connected() {
    xrandr --query | grep -q "^$1 connected"
}

workspace_exists() {
    i3-msg -t get_workspaces | grep -q "\"name\":\"$1\""
}

move_ws_if_exists() {
    ws="$1"
    output="$2"

    if workspace_exists "$ws"; then
        i3-msg "[workspace=\"$ws\"] move workspace to output $output" >/dev/null
    fi
}

first_connected() {
    for output in "$@"; do
        if is_connected "$output"; then
            printf '%s\n' "$output"
            return 0
        fi
    done

    return 1
}

WS_TERM="1:term"
WS_FIREFOX="2:web"
WS_CODE="3:code"
WS_EMAIL="4:mail"
WS_FILES="5:files"
WS_DOCS="6:pdfs"
WS_SPOTIFY="7:music"
WS_MISC="8:misc"
WS_VM="9:vm"
WS_EXTRA="10:extra"

LEFT="$(first_connected "$LEFT_PRIMARY" "$LEFT_ALT")"
RIGHT="$(first_connected "$RIGHT_PRIMARY" "$RIGHT_ALT")"

if [ -n "$LEFT" ] && [ -n "$RIGHT" ]; then
    xrandr --dpi "$DOCKED_DPI"

    move_ws_if_exists "$WS_FIREFOX" "$LEFT"
    move_ws_if_exists "$WS_CODE" "$RIGHT"
    move_ws_if_exists "$WS_TERM" "$LAPTOP"
    move_ws_if_exists "$WS_SPOTIFY" "$LAPTOP"

    move_ws_if_exists "$WS_EMAIL" "$LAPTOP"
    move_ws_if_exists "$WS_DOCS" "$RIGHT"
    move_ws_if_exists "$WS_FILES" "$RIGHT"
    move_ws_if_exists "$WS_MISC" "$LAPTOP"
    move_ws_if_exists "$WS_VM" "$RIGHT"
    move_ws_if_exists "$WS_EXTRA" "$RIGHT"
elif [ -n "$LEFT" ] || [ -n "$RIGHT" ]; then
    xrandr --dpi "$DOCKED_DPI"

    EXT="$RIGHT"
    if [ -n "$LEFT" ]; then
        EXT="$LEFT"
    fi

    move_ws_if_exists "$WS_FIREFOX" "$EXT"
    move_ws_if_exists "$WS_CODE" "$EXT"
    move_ws_if_exists "$WS_DOCS" "$EXT"
    move_ws_if_exists "$WS_FILES" "$EXT"
    move_ws_if_exists "$WS_VM" "$EXT"
    move_ws_if_exists "$WS_EXTRA" "$EXT"

    move_ws_if_exists "$WS_TERM" "$LAPTOP"
    move_ws_if_exists "$WS_EMAIL" "$LAPTOP"
    move_ws_if_exists "$WS_SPOTIFY" "$LAPTOP"
    move_ws_if_exists "$WS_MISC" "$LAPTOP"
else
    xrandr --dpi "$LAPTOP_DPI"

    for ws in \
        "$WS_TERM" "$WS_FIREFOX" "$WS_CODE" "$WS_EMAIL" "$WS_FILES" \
        "$WS_DOCS" "$WS_SPOTIFY" "$WS_MISC" "$WS_VM" "$WS_EXTRA"
    do
        move_ws_if_exists "$ws" "$LAPTOP"
    done
fi
